{
  "name": "dsh-mcp-manager",
  "version": "0.6.0",
  "description": "MCP server manager for DeepSeek Harness: manage MCP servers from the Web settings page, stored globally in $DSH_HOME/mcp-servers.json, connected/disconnected at runtime.",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ornithologist-love/dsh-mcp-manager.git"
  },
  "homepage": "https://github.com/ornithologist-love/dsh-mcp-manager",
  "bugs": {
    "url": "https://github.com/ornithologist-love/dsh-mcp-manager/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "prepack": "npm run build"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mcp",
    "deepseek-harness"
  ],
  "devDependencies": {
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "24.0.0",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.0",
    "esbuild": "0.28.2",
    "lightningcss": "1.32.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.1",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "dshFork": "mcp-integration-v1"
}
